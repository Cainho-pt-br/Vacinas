# ─────────────────────────────────────────────
# MODELO DE CONFIGURAÇÃO (.env.example)
# Copie este arquivo como '.env' e preencha com seus dados reais.
# ─────────────────────────────────────────────

# Pimaco Web Editor
PIMACO_URL=https://editor.pimaco.com.br/APWeb
PIMACO_EMAIL=seu_email_pimaco@exemplo.com
PIMACO_SENHA=sua_senha_pimaco
PIMACO_PRODUTO=6187

# Formatação das Etiquetas
FONTE_ETIQUETA=Arial
TAMANHO_FONTE=10

# GitHub — Repositório onde o formulário salva vacinas.json
GITHUB_TOKEN=seu_github_token_aqui
GITHUB_REPO=seu_usuario/Vacinas
GITHUB_FILE=vacinas.json

# Gmail — Backup do PDF por SMTP
GMAIL_USER=seu_email@gmail.com
GMAIL_APP_PASS=sua_senha_de_app_gmail
EMAIL_DESTINO=seu_email_destino@gmail.com
